{
  "name": "@toolbox/browser-engines",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./png-jpg-converter": {
      "types": "./dist/png-jpg-converter.d.ts",
      "require": "./dist/png-jpg-converter.js",
      "default": "./dist/png-jpg-converter.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@toolbox/config": "workspace:*",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@toolbox/contracts": "workspace:*",
    "@toolbox/core": "workspace:*",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289"
  }
}
